<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Application NUI pour Tizen 6.5. On compile contre Tizen.NET (API 9) sans l'embarquer :
    la TV fournit ces assemblies. Le .tpk est assemblé par tools/build.ps1.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <AssemblyName>QuietHome.Launcher</AssemblyName>
    <RootNamespace>QuietHome</RootNamespace>
    <UseAppHost>false</UseAppHost>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Tizen.NET" Version="$(TizenNetVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <ProjectReference Include="..\QuietHome.Core\QuietHome.Core.csproj" />
  </ItemGroup>
</Project>
